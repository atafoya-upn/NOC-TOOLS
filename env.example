# Copy this file to `.env` and place it next to your scripts
# (same folder as 920_DOWNLOAD_CONCURRENT.py and 920_UPGRADE_CONCURRENT.py).
# The scripts read these values and will prompt for anything left blank.
# Do NOT commit .env to version control.

# --- Generic (fallback) settings ---
# FTP_SERVER must be an IP address (IPv4 or IPv6). Example: 10.0.0.1
FTP_SERVER=10.0.0.1
FTP_USER=ftpuser
FTP_PASSWORD=changeme

# Optional generic device credentials (if blank, you'll be prompted)
DEVICE_USERNAME=
DEVICE_PASSWORD=

# --- Optional profile-based overrides ---
# If you select "Production" at the runtime prompt, *_PROD keys take precedence.
# If you select "Provisioning", *_PROV keys take precedence.
# Any missing values fall back to the generic keys above, then to prompts.

# Production
FTP_SERVER_PROD=10.0.0.2
FTP_USER_PROD=
FTP_PASSWORD_PROD=
DEVICE_USERNAME_PROD=
DEVICE_PASSWORD_PROD=

# Provisioning
FTP_SERVER_PROV=10.10.0.10
FTP_USER_PROV=
FTP_PASSWORD_PROV=
DEVICE_USERNAME_PROV=
DEVICE_PASSWORD_PROV=

# --- Misc runtime settings ---
# Possible option to add in the future but not currently used by the scripts
# Directory for saving logs (created if it doesn't exist)
# LOG_PATH=logs/
# Path to a device list file (one IP/hostname per line), if you use one
# DEVICE_LIST=data/devices.txt
